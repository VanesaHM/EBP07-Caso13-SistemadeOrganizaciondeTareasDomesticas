# Copia este archivo a .env y configura los valores segun tu entorno local

# Configuracion de Base de Datos
DATABASE_USER=postgres
DATABASE_PASSWORD=tu_contrasena_aqui
DATABASE_NAME=soyla
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Configuracion de Seguridad
# IMPORTANTE: Genera una clave segura de al menos 32 caracteres para produccion
JWT_SECRET=usa-una-clave-super-segura-de-32-caracteres-minimo

# Configuracion de URLs publicas
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_FRONTEND_PUBLIC_URL=http://localhost:5173
APP_BACKEND_PUBLIC_URL=http://localhost:8080

# Puerto de la aplicacion
PORT=8080
